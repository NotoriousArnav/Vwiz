# --- Gemini (LLM + embeddings) -------------------------------------------
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Google Cloud TTS (Chirp 3 HD) ---------------------------------------
# Chirp 3 HD requires a Cloud project with the TTS API enabled and
# application-default credentials. Chirp 3 HD is only served from the
# global / eu / us endpoints.
GOOGLE_CLOUD_PROJECT=
# Path to a service account key. Leave blank to fall back to ADC.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Search MCP ----------------------------------------------------------
TAVILY_API_KEY=

# --- Qdrant (memory) ------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Ingest guards --------------------------------------------------------
# Compressed size of one uploaded file. Note that .docx and .odt are zip
# archives, so this bounds the compressed bytes only.
MAX_UPLOAD_BYTES=33554432
# Characters kept from one document; the excess is dropped and reported.
MAX_DOCUMENT_CHARS=2000000
# Uncompressed size allowed for a zip-based document. Checked against the zip
# central directory before any inflation, so a small upload cannot expand into
# gigabytes of memory.
MAX_ARCHIVE_EXPANDED_BYTES=268435456
