# --- Gemini (LLM + TTS) ------------------------------------------------------
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Groq (fallback LLM when Gemini quota is hit) --------------------------
GROQ_API_KEY=

# --- Search MCP ----------------------------------------------------------
TAVILY_API_KEY=
EXA_API_KEY=

# --- Ingest guards --------------------------------------------------------
# Compressed size of one uploaded file. Note that .docx and .odt are zip
# archives, so this bounds the compressed bytes only.
MAX_UPLOAD_BYTES=33554432
# Characters kept from one document; the excess is dropped and reported.
MAX_DOCUMENT_CHARS=2000000
# Uncompressed size allowed for a zip-based document. Checked against the zip
# central directory before any inflation, so a small upload cannot expand into
# gigabytes of memory.
MAX_ARCHIVE_EXPANDED_BYTES=268435456
