# --- Gemini (LLM + embeddings) -------------------------------------------
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Google Cloud TTS (Chirp 3 HD) ---------------------------------------
# Chirp 3 HD requires a Cloud project with the TTS API enabled and
# application-default credentials. Chirp 3 HD is only served from the
# global / eu / us endpoints.
GOOGLE_CLOUD_PROJECT=
# Path to a service account key. Leave blank to fall back to ADC.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Search MCP ----------------------------------------------------------
TAVILY_API_KEY=

# --- Qdrant (memory) ------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=